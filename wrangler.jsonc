{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspace",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_duyvu",
      "database_id": "569b0708-7673-4d86-9ec4-8ff448f48f0e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NOTES",
      "id": "26eba944cf9d44cba41078c1ed498efb"
    }
  ]
}
